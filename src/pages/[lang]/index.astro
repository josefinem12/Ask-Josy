---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import { languages, t, fill, url } from '../../i18n/languages.js';
import { business, emailLink } from '../../settings/business.js';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const text = t(lang);
const home = text.home;
---
<Base lang={lang} page="" title={fill(home.title, lang)} description={fill(home.description, lang)}>

  <!-- 1. Welcome: what I do + call buttons -->
  <section class="hero">
    <div class="container hero-inner">
      <img
        class="hero-photo"
        src="/images/josy-face.jpg"
        alt={home.photoAlt}
        width="600"
        height="600"
      />
      <div class="hero-text">
        <h1>{home.heroTitle}</h1>
        <p class="lead">{home.heroText}</p>
        <p class="lead">{fill(home.heroLanguages, lang)}</p>
        <p class="call-prompt">{home.heroCallPrompt}</p>
        <ContactButtons lang={lang} />
      </div>
    </div>
  </section>

  <!-- 2. Safety promise -->
  <section class="container">
    <div class="safety-box">
      <Icon name="shield" size={48} />
      <div>
        <h2>{home.safetyBox.title}</h2>
        <p>{home.safetyBox.text}</p>
        <a class="text-link" href={url(lang, 'safety')}>{home.safetyBox.link}</a>
      </div>
    </div>
  </section>

  <!-- 3. Services -->
  <section class="section container" aria-labelledby="services-title">
    <h2 id="services-title">{home.servicesTitle}</h2>
    <ul class="card-grid">
      {home.services.map((service) => (
        <li class="card">
          <span class="card-icon"><Icon name={service.icon} size={36} /></span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
          {service.price && <p class="price">{service.label && `${service.label}: `}{fill(service.price, lang)}</p>}
        </li>
      ))}
    </ul>
    <p>
      <a class="button button-secondary" href={url(lang, 'services')}>
        <span>{home.servicesLink}</span>
        <Icon name="arrow" />
      </a>
    </p>
  </section>

  <!-- 4. How it works -->
  <section class="section section-tinted" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title">{home.stepsTitle}</h2>
      <ol class="steps">
        {home.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. About me (short) -->
  <section class="section container about-teaser" aria-labelledby="about-title">
    <div>
      <h2 id="about-title">{home.aboutTitle}</h2>
      <p>{fill(home.aboutText, lang)}</p>
      <a class="text-link" href={url(lang, 'about')}>{home.aboutLink}</a>
    </div>
  </section>

  <!-- 6. For adult children -->
  <section class="section container" aria-labelledby="family-title">
    <div class="family-box">
      <h2 id="family-title">{home.familyTitle}</h2>
      <p>{fill(home.familyIntro, lang)}</p>
      <ul class="check-list">
        {home.familyPoints.map((point) => (
          <li><Icon name="check" size={28} /><span>{point}</span></li>
        ))}
      </ul>
      <a class="button button-primary" href={url(lang, 'contact')}>
        <Icon name="calendar" />
        <span>{home.familyCta}</span>
      </a>
    </div>
  </section>

  <!-- 7. Contact -->
  <section class="section section-tinted" aria-labelledby="contact-title">
    <div class="container contact-end">
      <h2 id="contact-title">{home.contactTitle}</h2>
      <p>{home.contactText}</p>
      <ContactButtons lang={lang} />
      <div class="contact-buttons">
        <a class="button button-secondary" href={emailLink}>
          <Icon name="mail" />
          <span>{text.buttons.email}</span>
        </a>
        <a class="button button-secondary" href={url(lang, 'contact')}>
          <Icon name="calendar" />
          <span>{text.buttons.book}</span>
        </a>
      </div>
      <p class="email-line">{business.email}</p>
    </div>
  </section>

</Base>
