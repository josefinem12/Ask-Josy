---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, url } from '../i18n/languages.js';

interface Props {
  lang: string;
  page: string;
  title: string;
  description: string;
  alternates?: Record<string, string>;
}
const { lang, page, title, description, alternates = {} } = Astro.props;
const altLinks = Object.keys(languages).map((code) => [code, alternates[code] ?? url(code, page)]);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e5e5a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {altLinks.map(([code, href]) => (
      <link rel="alternate" hreflang={code} href={new URL(href, Astro.site)} />
    ))}
  </head>
  <body>
    <Header lang={lang} page={page} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
